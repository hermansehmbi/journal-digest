__pycache__/
*.pyc
preview_*.html
podcast.mp3
podcast_script.txt
*.mp3
*_script.txt

# Per-specialty runtime state (regenerated each run / cached by CI).
# monday_featured_*.json and weekly_summaries_*.json are intentionally TRACKED
# (committed by the Monday run) so the Saturday CME hand-off survives a wiped
# Actions cache. The rest are best-effort optimization caches and stay ignored.
# All regenerable caches now live under .cache/<specialty>/ (legacy root names
# kept ignored for older checkouts).
.cache/
articles_cache*.json
fulltext_cache*.json
summaries_cache*.json
doi_cache*.json
relevance_cache*.json
avail_cache*.json
self_assessment_tracker*.xlsx
moc_tracker*.xlsx
.env

# Local virtual environment
.venv/
venv/

# Google service-account keys — NEVER commit (use the GitHub Secret instead).
service_account*.json
*service-account*.json
gcp-*.json
credentials.json

# Published podcast episodes ARE tracked so GitHub Pages can serve them
# (any specialty's audio dir, e.g. docs/audio/ or docs/ep/audio/).
!docs/**/*.mp3
!docs/audio/*.mp3

# Intro/outro music MUST be committed so GitHub Actions can mix them in.
!assets/*.mp3

# macOS
.DS_Store
